{
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "strict": false,
    "ignoreDeprecations": "5.0",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["node"],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "jsx": "react",
    "esModuleInterop": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": [
        "./src/renderer/src/*"
      ]
    }
  }
}
