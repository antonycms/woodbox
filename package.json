{
  "name": "woodbox",
  "version": "1.0.16",
  "description": "An application to manage databases",
  "main": "./out/main/index.js",
  "author": "https://github.com/antonycms",
  "homepage": "https://www.electronjs.org",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "electron-vite build && electron-builder --mac --config",
    "build:mac:x64": "electron-vite build && electron-builder --mac dmg --x64 --config",
    "build:mac:arm64": "electron-vite build && electron-builder --mac dmg --arm64 --config",
    "build:linux": "electron-vite build && electron-builder --linux --config"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "knex": "^3.3.0",
    "mysql2": "^3.23.1",
    "pg": "^8.22.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@iconify-json/ant-design": "^1.2.8",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/bx": "^1.2.3",
    "@iconify-json/fa-regular": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/feather": "^1.2.1",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.37",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@xyflow/react": "^12.11.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-freeze": "^1.0.4",
    "typescript": "^7.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.5",
    "vite-plugin-svgr": "^5.2.0",
    "xlsx": "^0.18.5"
  }
}
